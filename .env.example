# CoverIt frontend environment
# Copy to .env.local for Vite local development.
# Public browser variables must be prefixed with VITE_.

# API / websocket endpoints.
VITE_API_URL=http://localhost:3000/api/v1
# Leave empty to derive ws://localhost:3000/api/v1 from VITE_API_URL.
VITE_WS_URL=

# App environment: development | staging | production.
VITE_APP_ENV=development

# Optional observability.
VITE_SENTRY_DSN=
VITE_POSTHOG_KEY=

# Docker image tag used by docker.sh when pulling remote frontend images.
# FRONTEND_TAG=dev
